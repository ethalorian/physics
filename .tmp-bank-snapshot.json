[{"id": "22befaef-3063-4541-8305-d3eb2b85212f", "code": "GV1", "prompt": "A line has slope −{a} $/day starting from ${b}0 on day 0. When does it hit zero?", "template": {"vars": {"a": {"min": 2, "max": 5}, "b": {"min": 4, "max": 9}}, "answer": "b*10/a", "sigFigs": 3, "answerUnit": "days"}}, {"id": "5567062e-1fd1-431f-b10a-73849538034d", "code": "GV1", "prompt": "A line passes through (0, {b}) and ({t}, {y}). What is its slope?", "template": {"vars": {"b": {"min": 2, "max": 10}, "t": {"min": 2, "max": 6}, "y": {"min": 20, "max": 60, "step": 4}}, "answer": "(y-b)/t", "sigFigs": 3}}, {"id": "58c343ea-062c-4190-9ceb-01d94a5fd282", "code": "GV1", "prompt": "A rate graph is flat at {a} L/min for {b} minutes. What does the area under it represent, and how much?", "template": {"vars": {"a": {"min": 2, "max": 6}, "b": {"min": 5, "max": 20, "step": 5}}, "answer": "a*b", "answerUnit": "L"}}, {"id": "5f37014d-9fb0-4270-b668-fd0f1793efff", "code": "GV1", "prompt": "A savings graph starts at $40 (the y-intercept) and climbs $15 each week. Where is it after {a} weeks?", "template": {"vars": {"a": {"min": 3, "max": 10}}, "answer": "40 + 15*a", "answerUnit": "$"}}, {"id": "7dca6a0e-9b73-4ef8-8b48-d86c3b8c139e", "code": "GV1", "prompt": "A line through ({a}, {b}0) and ({c}, {d}0) — find the slope.", "template": {"vars": {"a": {"min": 1, "max": 3}, "b": {"min": 2, "max": 4}, "c": {"min": 5, "max": 9}, "d": {"min": 6, "max": 9}}, "answer": "(d*10-b*10)/(c-a)", "sigFigs": 3}}, {"id": "7dd9f6e4-0182-4063-9f4b-fd7e8cce04bf", "code": "GV2", "prompt": "A line of best fit on earnings vs hours has slope {a}. What does an extra 3 hours earn?", "template": {"vars": {"a": {"min": 12, "max": 20}}, "answer": "a*3", "answerUnit": "$"}}, {"id": "99e9be04-b01d-4a21-a797-80750a228b3a", "code": "GV2", "prompt": "y vs 1/x is a line through the origin with slope {a}0. What is y at x = {b}?", "template": {"vars": {"a": {"min": 2, "max": 8}, "b": {"min": 2, "max": 10, "step": 2}}, "answer": "a*10/b", "sigFigs": 3}}, {"id": "f22b78e3-1941-4deb-a61c-9bb64a24ff87", "code": "GV2", "prompt": "y vs x² is a straight line through (0,0) with slope {a}. What is y when x = {b}?", "template": {"vars": {"a": {"min": 2, "max": 5}, "b": {"min": 2, "max": 5}}, "answer": "a*b^2"}}, {"id": "2276fd9d-0d27-4f8a-bee5-cf0082c20438", "code": "GV3", "prompt": "You go {a} m east then {b} m north. How far from the start?", "template": {"vars": {"a": {"min": 5, "max": 12}, "b": {"min": 5, "max": 12}}, "answer": "sqrt(a^2+b^2)", "sigFigs": 3, "answerUnit": "m"}}, {"id": "663cea01-64ee-4b58-b781-ed22906f2833", "code": "GV3", "prompt": "A treasure map: {b}0 paces at {a}° north of east. How many paces NORTH is the treasure?", "template": {"vars": {"a": {"min": 25, "max": 65, "step": 5}, "b": {"min": 3, "max": 9}}, "answer": "b*10*sin(a)", "sigFigs": 3, "answerUnit": "paces"}}, {"id": "84f33a76-c561-475b-b873-f087761edc2b", "code": "GV3", "prompt": "A ramp rises at {a}° and you travel {b} m along it. How much HEIGHT do you gain?", "template": {"vars": {"a": {"min": 20, "max": 50, "step": 5}, "b": {"min": 10, "max": 40, "step": 5}}, "answer": "b*sin(a)", "sigFigs": 3, "answerUnit": "m"}}, {"id": "9d59dc85-b0a0-4121-8a4f-21bf6ba7d06a", "code": "GV3", "prompt": "A move of {b} m at {a}° north of east — write BOTH components, then check them with the Pythagorean theorem.", "template": {"vars": {"a": {"min": 25, "max": 65, "step": 10}, "b": {"min": 10, "max": 50, "step": 10}}, "answer": "sqrt((b*cos(a))^2 + (b*sin(a))^2)", "sigFigs": 3, "answerUnit": "m"}}, {"id": "b9307a10-856b-4023-9be7-91658fc5f8ed", "code": "GV3", "prompt": "You walk {a} m east, then {b} m north. How many metres did you WALK in total (path length, not distance from start)?", "template": {"vars": {"a": {"min": 2, "max": 9}, "b": {"min": 2, "max": 9}}, "answer": "a+b", "answerUnit": "m"}}, {"id": "eb26bb22-820c-410b-b143-4930ed009b02", "code": "GV3", "prompt": "A kite string is {b} m long at {a}° above level ground. How high is the kite?", "template": {"vars": {"a": {"min": 30, "max": 70, "step": 5}, "b": {"min": 20, "max": 60, "step": 10}}, "answer": "b*sin(a)", "sigFigs": 3, "answerUnit": "m"}}, {"id": "f1a0b5fc-24db-47c5-8ab0-7062de7417ad", "code": "GV3", "prompt": "You walk {b} m at {a}° north of east. How far EAST have you gone?", "template": {"vars": {"a": {"min": 20, "max": 60, "step": 5}, "b": {"min": 10, "max": 50, "step": 10}}, "answer": "b*cos(a)", "sigFigs": 3, "answerUnit": "m"}}, {"id": "25a30845-38a9-44cb-bb8d-4d29e66d0e8d", "code": "NS1", "prompt": "Which is larger: {a}.0{b} or {a}.{b}?", "template": {"vars": {"a": {"min": 1, "max": 9}, "b": {"min": 1, "max": 9}}, "answer": "a + b/10"}}, {"id": "5d70c568-9db7-407a-bf4f-a478598e85a5", "code": "NS1", "prompt": "On a number line, what number is exactly halfway between {a} and {b}?", "template": {"vars": {"a": {"min": 2, "max": 20}, "b": {"min": 30, "max": 80, "step": 2}}, "answer": "(a+b)/2"}}, {"id": "9591a836-95f4-4498-8b8a-e90d634c7ba3", "code": "NS1", "prompt": "How many hundredths are in {a}.{b}?", "template": {"vars": {"a": {"min": 1, "max": 9}, "b": {"min": 1, "max": 9}}, "answer": "a*100 + b*10"}}, {"id": "a4355aec-32ee-44ac-92aa-6288123dc59f", "code": "NS1", "prompt": "Which is larger: {a},{b}18 or {a},{b}81?", "template": {"vars": {"a": {"min": 2, "max": 9}, "b": {"min": 1, "max": 9}}, "answer": "a*1000+b*100+81", "sigFigs": 6}}, {"id": "f6cfd880-2194-4416-a2a6-18183d57ed01", "code": "NS1", "prompt": "Round {a}.{b}6 to the nearest tenth.", "template": {"vars": {"a": {"min": 1, "max": 9}, "b": {"min": 1, "max": 8}}, "answer": "a + (b+1)/10"}}, {"id": "1f82f349-72c5-4ac4-b3f4-be29651b18dd", "code": "NS2", "prompt": "{a}% of a number is {b}. What is the number?", "template": {"vars": {"a": {"min": 20, "max": 80, "step": 10}, "b": {"min": 12, "max": 96, "step": 12}}, "answer": "100*b/a", "sigFigs": 3}}, {"id": "4e4505b1-e34d-47ea-b1ca-6f8aa52652cd", "code": "NS2", "prompt": "You made {a} of {b} free throws. What fraction is that, and about what percent?", "template": {"vars": {"a": {"min": 3, "max": 9}, "b": {"min": 10, "max": 20, "step": 10}}, "answer": "100*a/b"}}, {"id": "a8becc1d-56c3-4680-b612-63b5a9e3b001", "code": "NS2", "prompt": "What is {a}% of {b}?", "template": {"vars": {"a": {"min": 10, "max": 90, "step": 10}, "b": {"min": 20, "max": 400, "step": 20}}, "answer": "a*b/100"}}, {"id": "bcdcd404-a96e-4bd2-88ae-bd9253a8fa12", "code": "NS2", "prompt": "A ${b} hoodie is {a}% off. What do you pay?", "template": {"vars": {"a": {"min": 10, "max": 50, "step": 10}, "b": {"min": 20, "max": 80, "step": 4}}, "answer": "b - a*b/100", "answerUnit": "$"}}, {"id": "d6e59535-2837-472a-afa0-d6af8b796b73", "code": "NS2", "prompt": "Your quiz score went from {a} points to {b} points. What is the percent increase?", "template": {"vars": {"a": {"min": 20, "max": 40, "step": 5}, "b": {"min": 45, "max": 80, "step": 5}}, "answer": "100*(b-a)/a", "sigFigs": 3}}, {"id": "e22f4e73-647b-4a46-af57-1c8f69285db1", "code": "NS2", "prompt": "Write {a}% as a decimal.", "template": {"vars": {"a": {"min": 5, "max": 95, "step": 5}}, "answer": "a/100"}}, {"id": "02af6d07-9a0a-4cfe-ac7e-a348b8a781e9", "code": "PR1", "prompt": "Paint covers {a} m² per liter. How many liters for a {b} m² wall?", "template": {"vars": {"a": {"min": 8, "max": 12}, "b": {"min": 40, "max": 120, "step": 8}}, "answer": "b/a", "sigFigs": 3, "answerUnit": "L"}}, {"id": "1bdf950e-8d5b-4dd4-a4df-d49d6f0c07b6", "code": "PR1", "prompt": "A recipe uses {a} cups of flour for 12 cookies. How much flour for 36 cookies?", "template": {"vars": {"a": {"min": 2, "max": 4}}, "answer": "a*3", "answerUnit": "cups"}}, {"id": "5af7f276-fdf3-4247-81cd-06da60872743", "code": "PR1", "prompt": "Socks come 3 pairs to a pack. How many packs for {a} pairs?", "template": {"vars": {"a": {"min": 9, "max": 27, "step": 3}}, "answer": "a/3", "answerUnit": "packs"}}, {"id": "75ee7a27-a262-4a54-abbf-64ca430e5aae", "code": "PR1", "prompt": "A phone battery loses {a}% in 45 minutes of video. Roughly how many minutes of video from full?", "template": {"vars": {"a": {"min": 10, "max": 30, "step": 5}}, "answer": "45*100/a", "sigFigs": 3, "answerUnit": "min"}}, {"id": "8ba8071d-bb2c-4bf6-8eb3-cb3aecf6d662", "code": "PR1", "prompt": "Two towns are {a} cm apart on a map with scale 1 : 250,000. How far apart in km?", "template": {"vars": {"a": {"min": 4, "max": 20, "step": 2}}, "answer": "a*2.5", "answerUnit": "km"}}, {"id": "a1ddd105-3c08-4e6c-b7f4-6e5024749dca", "code": "PR1", "prompt": "{a} identical tickets cost ${b}. What do 7 tickets cost?", "template": {"vars": {"a": {"min": 2, "max": 4}, "b": {"min": 24, "max": 60, "step": 12}}, "answer": "7*b/a", "sigFigs": 3, "answerUnit": "$"}}, {"id": "a8c0a6d0-fc60-4af7-a339-5625638c809f", "code": "PR1", "prompt": "A map says 1 cm = 5 km. How far is {a} cm on the map?", "template": {"vars": {"a": {"min": 3, "max": 12}}, "answer": "a*5", "answerUnit": "km"}}, {"id": "dbee229d-fb30-4c64-8edf-b5eaf0d5f6f9", "code": "PR1", "prompt": "{a} granola bars cost ${b}. What does one cost?", "template": {"vars": {"a": {"min": 3, "max": 6}, "b": {"min": 3, "max": 12, "step": 3}}, "answer": "b/a", "sigFigs": 3, "answerUnit": "$"}}, {"id": "f859c8a3-8e48-4b97-acfc-c7258286391c", "code": "PR1", "prompt": "A car uses {a} gallons to go {b} miles. At that rate, how far on 10 gallons?", "template": {"vars": {"a": {"min": 2, "max": 5}, "b": {"min": 60, "max": 150, "step": 10}}, "answer": "10*b/a", "sigFigs": 3, "answerUnit": "miles"}}, {"id": "4c100d6f-3896-44f3-a890-7ee6863c1bd5", "code": "PR2", "prompt": "y = k/x², and y = {a} when x = 1. What is y when x = 2?", "template": {"vars": {"a": {"min": 16, "max": 96, "step": 16}}, "answer": "a/4"}}, {"id": "4d399a27-f7ba-4eaf-a70e-25a43cf615f1", "code": "PR2", "prompt": "y is proportional to x, and y = {a} when x = 2. What is y when x = 6?", "template": {"vars": {"a": {"min": 4, "max": 20, "step": 2}}, "answer": "a*3"}}, {"id": "a4efeaab-9323-42af-9909-4b6ca438ff80", "code": "PR2", "prompt": "y = k/x², and y = {a} when x = 6. What is y when x = 3?", "template": {"vars": {"a": {"min": 2, "max": 10}}, "answer": "a*4"}}, {"id": "d31f68ae-9de4-4de0-a917-ec9b477a858a", "code": "PR2", "prompt": "y = k·x and y = {a} when x = {b}. Find y when x = {c}.", "template": {"vars": {"a": {"min": 6, "max": 30, "step": 6}, "b": {"min": 2, "max": 5}, "c": {"min": 6, "max": 12}}, "answer": "a*c/b", "sigFigs": 3}}, {"id": "24b8d268-ac7e-4320-98ca-98fd1395bc01", "code": "QE1", "prompt": "Multiply: (2 × 10^{a}) × (3 × 10^{b}).", "template": {"vars": {"a": {"min": 2, "max": 5}, "b": {"min": 2, "max": 5}}, "answer": "6*10^(a+b)", "sigFigs": 1}}, {"id": "94657673-d6ac-4a79-95c0-28ba4203e348", "code": "QE1", "prompt": "Divide: (8 × 10^{a}) ÷ (4 × 10^{b}).", "template": {"vars": {"a": {"min": 6, "max": 9}, "b": {"min": 2, "max": 5}}, "answer": "2*10^(a-b)", "sigFigs": 1}}, {"id": "bc0903dd-dfec-453a-9bed-0499a0e8ed97", "code": "QE1", "prompt": "Estimate {a},000 × {b},000 using powers of ten.", "template": {"vars": {"a": {"min": 2, "max": 9}, "b": {"min": 2, "max": 9}}, "answer": "a*b*10^6", "sigFigs": 2}}, {"id": "e2cd119e-9940-4d7a-9e0c-8d2441351177", "code": "QE1", "prompt": "A song stream moves about {a} × 10^6 bytes and your plan has {b} × 10^9 bytes. How many streams is that?", "template": {"vars": {"a": {"min": 3, "max": 8}, "b": {"min": 2, "max": 10}}, "answer": "b*10^9/(a*10^6)", "sigFigs": 2}}, {"id": "1c237701-99de-47fb-9b43-a07de9265799", "code": "QE2", "prompt": "Convert {a} m/min into cm/s.", "template": {"vars": {"a": {"min": 6, "max": 30, "step": 6}}, "answer": "a*100/60", "sigFigs": 3, "answerUnit": "cm/s"}}, {"id": "1e65757c-4c31-4601-aa68-72dd19e9ccc0", "code": "QE2", "prompt": "Convert {a} km/h to m/s.", "template": {"vars": {"a": {"min": 18, "max": 108, "step": 9}}, "answer": "a/3.6", "sigFigs": 3, "answerUnit": "m/s"}}, {"id": "23f45039-3c9d-4132-934c-0e2b0e546860", "code": "QE2", "prompt": "{a} km in {b} minutes — what speed in km/h?", "template": {"vars": {"a": {"min": 5, "max": 30, "step": 5}, "b": {"min": 10, "max": 50, "step": 10}}, "answer": "a*60/b", "sigFigs": 3, "answerUnit": "km/h"}}, {"id": "5581c6de-5241-453d-9409-da0f3e85593c", "code": "QE2", "prompt": "Grapes are ${a} per kg. What do {b}00 g cost?", "template": {"vars": {"a": {"min": 4, "max": 9}, "b": {"min": 2, "max": 8}}, "answer": "a*b/10", "sigFigs": 3, "answerUnit": "$"}}, {"id": "8379b0e0-60cd-499e-9d2a-030e30f464d5", "code": "QE2", "prompt": "A movie is {a} minutes long. Express that in hours and minutes.", "template": {"vars": {"a": {"min": 95, "max": 150, "step": 5}}, "answer": "a/60", "sigFigs": 3}}, {"id": "9ebb64af-319b-4e5c-9ed2-b345f78914fd", "code": "QE2", "prompt": "A printer prints {a} pages per minute. How many pages per hour?", "template": {"vars": {"a": {"min": 8, "max": 30, "step": 2}}, "answer": "a*60", "answerUnit": "pages"}}, {"id": "ca5b8849-c494-4e80-9509-8e5a7111ee56", "code": "QE2", "prompt": "Convert {a} mL to liters.", "template": {"vars": {"a": {"min": 250, "max": 4000, "step": 250}}, "answer": "a/1000", "sigFigs": 3, "answerUnit": "L"}}, {"id": "d8284f1a-f363-40d8-a2f3-edfba6fd8b3c", "code": "QE2", "prompt": "Convert {a} minutes to hours.", "template": {"vars": {"a": {"min": 90, "max": 300, "step": 15}}, "answer": "a/60", "sigFigs": 3, "answerUnit": "h"}}, {"id": "dc9e6e0e-1e7e-4f3b-99e6-801468a127e3", "code": "QE2", "prompt": "Convert {a} cm to meters.", "template": {"vars": {"a": {"min": 120, "max": 900, "step": 20}}, "answer": "a/100", "sigFigs": 3, "answerUnit": "m"}}, {"id": "e68b085a-db1a-4efd-9775-3b708360f92d", "code": "QE2", "prompt": "Convert {a} kg to grams.", "template": {"vars": {"a": {"min": 2, "max": 9}}, "answer": "a*1000", "answerUnit": "g"}}, {"id": "0f7c6958-1019-4739-b650-c230e7731609", "code": "QE3", "prompt": "Estimate {a} × 39 by rounding first.", "template": {"vars": {"a": {"min": 11, "max": 29}}, "answer": "a*39", "sigFigs": 2}}, {"id": "10894097-95c4-49a4-aab0-f0c1eec1354c", "code": "QE4", "prompt": "Your calculator says {a}.{b}285714. The inputs each had 2 sig figs. Report the answer.", "template": {"vars": {"a": {"min": 1, "max": 9}, "b": {"min": 1, "max": 9}}, "answer": "a + b/10", "sigFigs": 2}}, {"id": "6774650e-084e-4e04-9713-e5c42ae06962", "code": "QE4", "prompt": "Round {a}.{b}472 to three significant figures.", "template": {"vars": {"a": {"min": 1, "max": 9}, "b": {"min": 1, "max": 9}}, "answer": "a + b/10 + 0.047", "sigFigs": 3}}, {"id": "b6293193-6a2b-4db0-a689-cf7446092ec6", "code": "QE4", "prompt": "Percent error: you estimated {a}0 and the true value was 100. What is the percent error?", "template": {"vars": {"a": {"min": 6, "max": 14}}, "answer": "abs(a*10-100)"}}, {"id": "121add02-31ac-4cb0-8d07-dfe6fe6a8e6b", "code": "SM2", "prompt": "C = 2πr with r = {a} cm. Evaluate to one decimal.", "template": {"vars": {"a": {"min": 3, "max": 12}}, "answer": "2*3.14159*a", "sigFigs": 3, "answerUnit": "cm"}}, {"id": "22975168-2798-4050-bd40-3ef19206eb9f", "code": "SM2", "prompt": "y = {a} − 2x with x = {b}. Watch the sign.", "template": {"vars": {"a": {"min": 4, "max": 10}, "b": {"min": 6, "max": 12}}, "answer": "a - 2*b"}}, {"id": "3c243e1f-5ae2-4632-a2bd-f424dd217b7a", "code": "SM2", "prompt": "y = {a}·2^x with x = {b}. Evaluate.", "template": {"vars": {"a": {"min": 2, "max": 5}, "b": {"min": 3, "max": 6}}, "answer": "a*2^b"}}, {"id": "6c0822f2-e0ff-4766-b70a-55a15901ef77", "code": "SM2", "prompt": "y = {a}(x − {b}) with x = {c}. Evaluate — parentheses first.", "template": {"vars": {"a": {"min": 2, "max": 6}, "b": {"min": 1, "max": 5}, "c": {"min": 6, "max": 14}}, "answer": "a*(c-b)"}}, {"id": "7593b721-626d-4c0c-8578-07d10263f1ea", "code": "SM2", "prompt": "Average = total ÷ count. Total = {a} points over {b} games.", "template": {"vars": {"a": {"min": 60, "max": 240, "step": 12}, "b": {"min": 3, "max": 12, "step": 3}}, "answer": "a/b", "sigFigs": 3, "answerUnit": "points/game"}}, {"id": "7b413ddd-81ce-4ed3-8754-c544fdc64956", "code": "SM2", "prompt": "y = x² with x = {a}. Evaluate.", "template": {"vars": {"a": {"min": 3, "max": 12}}, "answer": "a^2"}}, {"id": "8eeb1cef-b182-4c35-a38f-1db6005ca6d6", "code": "SM2", "prompt": "y = {a}x + {b}. Evaluate y when x = {c}.", "template": {"vars": {"a": {"min": 2, "max": 6}, "b": {"min": 1, "max": 9}, "c": {"min": 2, "max": 9}}, "answer": "a*c + b"}}, {"id": "8f59c0bb-47b7-4dfd-ad38-56fc1f9c936a", "code": "SM2", "prompt": "V = x³ with x = {a} cm. Evaluate with the unit.", "template": {"vars": {"a": {"min": 2, "max": 6}}, "answer": "a^3", "answerUnit": "cm³"}}, {"id": "92dfdd2f-12b2-419c-81d3-54fd69f3c855", "code": "SM2", "prompt": "A = ½bh with b = {a} cm, h = {b} cm.", "template": {"vars": {"a": {"min": 4, "max": 16, "step": 2}, "b": {"min": 3, "max": 11}}, "answer": "a*b/2", "answerUnit": "cm²"}}, {"id": "94c41b46-2c93-44d2-9caf-53faa57dd67f", "code": "SM2", "prompt": "Cost = ${a} + ${b} per mile, for {c} miles.", "template": {"vars": {"a": {"min": 2, "max": 5}, "b": {"min": 1, "max": 3}, "c": {"min": 4, "max": 15}}, "answer": "a + b*c", "answerUnit": "$"}}, {"id": "bfcb9fee-f7ae-46ae-8dcf-c1c2571ecab7", "code": "SM2", "prompt": "y = √(a² + b²) with a = {a}, b = {b}. Evaluate.", "template": {"vars": {"a": {"min": 3, "max": 9}, "b": {"min": 4, "max": 12}}, "answer": "sqrt(a^2 + b^2)", "sigFigs": 3}}, {"id": "e1a2e8f5-a1a6-4069-9d69-145195cb561b", "code": "SM2", "prompt": "z = (x + y)² with x = {a}, y = {b}. Why isn't it x² + y²?", "template": {"vars": {"a": {"min": 2, "max": 6}, "b": {"min": 3, "max": 7}}, "answer": "(a+b)^2"}}, {"id": "ed13ea35-ef46-491e-9fd0-7896138e2dd0", "code": "SM2", "prompt": "P = 2l + 2w with l = {a} m, w = {b} m. Find P.", "template": {"vars": {"a": {"min": 4, "max": 15}, "b": {"min": 2, "max": 9}}, "answer": "2*a + 2*b", "answerUnit": "m"}}, {"id": "f0dab88b-e022-4601-92e5-82a434f30209", "code": "SM2", "prompt": "A = l·w with l = {a} cm and w = {b} cm. Find A with its unit.", "template": {"vars": {"a": {"min": 3, "max": 12}, "b": {"min": 3, "max": 9}}, "answer": "a*b", "answerUnit": "cm²"}}, {"id": "ff532a22-3347-4727-a026-a5c6082fa4df", "code": "SM2", "prompt": "y = x/( {a} + {b} ) with x = {c}0. Evaluate.", "template": {"vars": {"a": {"min": 1, "max": 4}, "b": {"min": 1, "max": 5}, "c": {"min": 3, "max": 9}}, "answer": "c*10/(a+b)", "sigFigs": 3}}]